server:
  insecure: true

configs:
  params:
    server.insecure: true
  cm:
    # Lab stand: disable the chart-generated random admin in favor of `{{ argocd_admin_username }}`.
    admin.enabled: "false"
    accounts.{{ argocd_admin_username }}: login
  rbac:
    policy.default: ''
    policy.csv: |
      g, {{ argocd_admin_username }}, role:admin
  secret:
    extra:
      accounts.{{ argocd_admin_username }}.password: {{ argocd_admin_password_hash | quote }}
