server:
  insecure: true

configs:
  params:
    server.insecure: true
  cm:
    # Allow the `{{ argocd_admin_username }}` local account to log in.
    accounts.{{ argocd_admin_username }}: login
  rbac:
    policy.default: ''
    policy.csv: |
      g, {{ argocd_admin_username }}, role:admin
  secret:
    # Bcrypt hash for the `{{ argocd_admin_username }}` local user.
    extra:
      accounts.{{ argocd_admin_username }}.password: {{ argocd_admin_password_hash | quote }}
